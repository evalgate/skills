{
	"$schema": "./skill-spec.schema.json",
	"skill": "setup-evalgate-project",
	"audience": "engineering",
	"goal": "Preview and apply a reviewed first scaffold and baseline, locally by default.",
	"outputs": [
		"reviewed file list",
		"non-empty passing baseline",
		"gate result"
	],
	"usesCli": true,
	"requiredCommands": [
		"status --json",
		"capabilities evaluate --format json",
		"init --local",
		"gate --format json"
	],
	"forbiddenPatterns": [
		"npx evalgate [a-z]"
	],
	"targets": {
		"agents": [
			"claude-code",
			"codex",
			"cursor",
			"opencode"
		],
		"models": [
			"anthropic:claude-sonnet-5-5",
			"openai:gpt-4.1-mini"
		]
	},
	"cases": "evaluations/skills/setup-evalgate-project.cases.jsonl",
	"budget": {
		"maxLines": 500,
		"maxDescriptionChars": 400,
		"maxWords": 1050
	}
}
