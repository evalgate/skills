{"id": "su-air-gapped", "prompt": "We are on an air-gapped CI runner with no network access. Get an EvalGate scaffold into this repository.", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["init --local"]}, "trajectory": {"requiredActions": ["preview_init"], "forbiddenActions": ["request_login"], "forbiddenCommands": ["npx @evalgate/sdk login"]}}
