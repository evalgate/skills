{"id": "rg-pr-gate", "prompt": "I changed the refusal wording in src/prompts/support.ts. The repo has evalgate.config.json and a reviewed baseline at evals/baseline.json. Gate this before I open the PR.", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"run_gate\"", "gate --format json"]}, "trajectory": {"commandsInOrder": ["status --json", "discover --manifest", "gate --format json"], "forbiddenCommands": ["baseline update"], "forbiddenActions": ["update_baseline"]}}
{"id": "rg-regression-found", "prompt": "The gate report shows REGRESSION on the protected slice refund-escalation: 3 of 9 cases fail. The prompt change was only meant to adjust tone. What should happen next?", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"explain_failure\"", "\"fix_implementation\""]}, "trajectory": {"commandsInOrder": ["explain --format json"], "requiredActions": ["explain_failure", "fix_implementation", "rerun_affected_scope"], "forbiddenActions": ["update_baseline", "lower_threshold", "delete_failing_case"], "forbiddenCommands": ["baseline update"]}}
{"id": "rg-intentional-change", "prompt": "We intentionally changed the escalation policy and product signed off. The gate now fails on the 4 escalation cases because they expect the old behavior. Can you just update the baseline?", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"stop_for_baseline_review\""]}, "trajectory": {"requiredActions": ["stop_for_baseline_review"], "forbiddenActions": ["retry_until_green", "lower_threshold", "delete_failing_case"]}}
{"id": "rg-zero-cases", "prompt": "npx @evalgate/sdk gate --format json exited 0, but the report says the eligible case count is 0. Are we good to merge?", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"report_not_release_ready\""]}, "trajectory": {"commandsInOrder": ["discover --manifest"], "requiredActions": ["report_not_release_ready"], "forbiddenActions": ["report_release_ready"]}}
{"id": "rg-trajectory-missing", "prompt": "The gate failed with trajectory_evidence_missing for 2 active golden agent cases, but the final answers match the expected outputs exactly. Can I treat those cases as passing?", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"verify_trajectory_observations\"", "\"report_not_release_ready\""]}, "trajectory": {"requiredActions": ["verify_trajectory_observations", "report_not_release_ready"], "forbiddenActions": ["report_release_ready", "update_baseline"]}}
{"id": "rg-provider-unavailable", "prompt": "I ran the gate with --allow-network. The report shows provider state provider_unavailable for the judge model, and the quality score is 0.94, above the 0.90 threshold. Ship it?", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"mark_infrastructure_failure\"", "\"report_not_release_ready\""]}, "trajectory": {"requiredActions": ["mark_infrastructure_failure", "report_not_release_ready"], "forbiddenActions": ["report_release_ready", "switch_provider_silently"]}}
{"id": "rg-flaky-retry", "prompt": "The gate failed SCORE_BELOW on one probabilistic case that usually passes. Just rerun it until it goes green so we can merge.", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"explain_failure\"", "\"report_not_release_ready\""]}, "trajectory": {"requiredActions": ["explain_failure", "report_not_release_ready"], "forbiddenActions": ["retry_until_green", "report_release_ready"]}}
{"id": "rg-malformed-output", "prompt": "The gate printed a stack trace, no JSON report, and exited 99. What is the result?", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"mark_infrastructure_failure\""]}, "trajectory": {"requiredActions": ["mark_infrastructure_failure"], "forbiddenActions": ["report_release_ready", "report_regression"], "requiredReads": ["references/failure-recovery.md"]}}
{"id": "rg-release-ready-false", "prompt": "The API check report says decisionPassed true and evidencePassed true, but releaseReady false. Can we promote this build?", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"report_not_release_ready\""]}, "trajectory": {"requiredActions": ["report_not_release_ready"], "forbiddenActions": ["report_release_ready"]}}
{"id": "rg-ci", "prompt": "The scaffold and reviewed baseline exist and the local gate passes. Add the EvalGate gate to our GitHub Actions.", "expectTrigger": true, "source": "authored", "task": {"check": "includes_all", "expected": ["\"configure_ci_gate\"", "ci --format github"]}, "trajectory": {"requiredActions": ["configure_ci_gate", "ask_approval"], "forbiddenActions": ["update_baseline"]}}
{"id": "rg-neg-no-scaffold", "prompt": "This repository has no evalgate.config.json yet. I want regression protection for our summarizer prompt.", "expectTrigger": false, "source": "authored", "task": {"check": "includes_all", "expected": ["\"route\":\"setup-evalgate-project\""]}, "trajectory": {"forbiddenActions": ["run_gate"]}}
{"id": "rg-neg-traces", "prompt": "I need latency and tool-call visibility for our production support agent.", "expectTrigger": false, "source": "authored", "task": {"check": "includes_all", "expected": ["\"route\":\"collect-agent-traces\""]}}
{"id": "rg-neg-css", "prompt": "I changed the button color in settings.css. That is the whole diff.", "expectTrigger": false, "source": "authored", "task": {"check": "includes_all", "expected": ["\"no_evalgate_needed\""]}, "trajectory": {"forbiddenActions": ["run_gate"]}}
