{
	"name": "@evalgate/agent-skills-distribution",
	"version": "1.3.0",
	"private": true,
	"description": "Validation and behavioral evaluation contracts for the public EvalGate Agent Skills distribution.",
	"type": "module",
	"scripts": {
		"test": "node tests/run.mjs",
		"validate": "node scripts/validate-distribution.mjs",
		"test:behavior": "node scripts/evaluate-ai-change-harness.mjs --mode fixture",
		"test:behavior:live": "node scripts/evaluate-ai-change-harness.mjs --mode live",
		"check:commands": "node scripts/check-commands.mjs",
		"export:website": "node scripts/export-website.mjs",
		"check:standalone": "node scripts/check-standalone.mjs",
		"lint:skills": "node scripts/lint-skills.mjs --report",
		"test:skills": "node scripts/skill-tests.mjs --mode fixture",
		"test:skills:live": "node scripts/skill-tests.mjs --mode live",
		"test:ablation": "node scripts/evaluate-ai-change-harness.mjs --mode live --arm both --trials 3",
		"measure:mcp": "node scripts/measure-mcp-context.mjs"
	},
	"engines": {
		"node": ">=20"
	},
	"license": "MIT"
}
